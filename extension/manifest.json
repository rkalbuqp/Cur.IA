{
  "manifest_version": 3,
  "name": "Curia IA - Automação de Registros de Casamento",
  "version": "1.1.2",
  "description": "Automação de digitação de registros antigos de casamento no sistema Cúria Online via OCR com IA.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://diocesenazare.curiaonline.com.br/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Curia IA",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://diocesenazare.curiaonline.com.br/*"],
      "js": [
        "content/utils.js",
        "content/automation.js",
        "content/widget.js",
        "content/main.js"
      ],
      "css": [
        "content/widget.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
